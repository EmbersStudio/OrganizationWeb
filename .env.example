# ===== 应用环境变量示例 =====
# 复制为 .env 后按需修改（.env 已被 gitignore，不会提交）

# 缓存开关：默认启用（缓存优先）；设为 false 则实时抓取
USE_CACHE=true

# 缓存有效期（秒），覆盖 config/cache.ts 中的默认值（当前未读取，TTL 固定为 3600）
# CACHE_TTL=3600

# ===== 部署相关（可选）=====
# Cloudflare 账号 ID（wrangler 登录后通常无需手动设置）
# CLOUDFLARE_ACCOUNT_ID=your-account-id

# KV 命名空间 ID（更推荐直接修改 wrangler.toml 中的 [[kv_namespaces]] id）
# CLOUDFLARE_KV_NAMESPACE_ID=your-kv-namespace-id

# ===== 认证（Better Auth）=====
# 必填：Better Auth 会话/令牌加密密钥（可用 openssl rand -base64 32 生成）。
# 本地开发：写入 .dev.vars（或 .env.local）供 npm run dev 读取；
# 部署环境：请在 Cloudflare Workers 的“变量与机密”中配置同名机密变量。
BETTER_AUTH_SECRET=replace-with-a-random-64-char-secret

# 站点公开地址（可选）。默认按请求 Host 自动识别，
# 部署在自定义域名时建议显式声明，便于生成回调与邮件链接。
# BETTER_AUTH_URL=https://embers-studio.crimsonseraph.top

# 额外受信任来源（逗号分隔，可选；同源域名无需配置）
# BETTER_AUTH_TRUSTED_ORIGINS=https://preview.example.workers.dev

# GitHub OAuth（可选）：配置后 /login 页面启用“使用 GitHub 登录”
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret

# 前端指向的服务端地址（可选；同源部署无需配置）
# NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# ===== Cloudflare Web Analytics（RUM）=====
# 无需任何环境变量：RUM（beacon.min.js + /cdn-cgi/rum）由 Cloudflare 边缘自动注入，
# 仓库内不手动干预（见 docs/PERFORMANCE.md）。
