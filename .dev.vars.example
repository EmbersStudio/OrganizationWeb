# Cloudflare 本地开发变量模板（复制为 .dev.vars 后填写）
# .dev.vars 已被 .gitignore 忽略，不会提交；生产环境请在
# Cloudflare Dashboard → Workers & Pages → 设置 → 变量与机密中配置同名机密。

# Better Auth 密钥（必填）：openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-random-64-char-hex-or-base64-secret"

# 站点公开地址（可选，部署在自定义域名时建议填写）
# BETTER_AUTH_URL="https://embers-studio.crimsonseraph.top"

# 额外受信任来源（逗号分隔，可选）
# BETTER_AUTH_TRUSTED_ORIGINS="https://preview.example.workers.dev"

# GitHub OAuth（可选，配置后 /login 页面启用 GitHub 登录）
# GITHUB_CLIENT_ID="your-github-client-id"
# GITHUB_CLIENT_SECRET="your-github-client-secret"
