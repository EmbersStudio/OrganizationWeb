{
  "name": "organization-web",
  "version": "0.1.0",
  "private": true,
  "description": "基于 Next.js (App Router) + OpenNext 的全栈网站，部署于 Cloudflare",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:opennext": "opennextjs-cloudflare build",
    "start": "next start",
    "preview": "opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare deploy",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260830.1",
    "@opennextjs/cloudflare": "^1.20.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prettier": "^3.6.2",
    "typescript": "^5",
    "wrangler": "^4.127.1"
  }
}
