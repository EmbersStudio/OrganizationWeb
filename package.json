{
  "name": "organization-web",
  "version": "0.1.0",
  "private": true,
  "description": "基于 Next.js (App Router) + OpenNext 的全栈网站，部署于 Cloudflare",
  "overrides": {
    "esbuild": "^0.25.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:opennext": "opennextjs-cloudflare build",
    "start": "next start",
    "preview": "opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare deploy",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply organization_web --local",
    "db:migrate:remote": "wrangler d1 migrations apply organization_web --remote"
  },
  "dependencies": {
    "better-auth": "^1.7.2",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260905.1",
    "@opennextjs/cloudflare": "^1.20.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typescript": "^5",
    "wrangler": "^4.127.1"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
